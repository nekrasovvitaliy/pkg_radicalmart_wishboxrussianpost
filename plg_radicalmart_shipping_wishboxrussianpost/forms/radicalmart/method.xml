                   required="true"/>

            <field name="sender_phone_additional" type="textarea"
                   label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_SENDER_PHONE_ADDITIONAL_LABEL"
                   maxlength="255"/>
        </fields>

    </fieldset>

    <fieldset name="seller" label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELDSET_SELLER">
