    <fieldset name="sender" label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELDSET_SENDER">
        <fields name="params">

            <field name="sender_company" type="text"
                   label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_SENDER_COMPANY_LABEL"
            />

            <field name="index_from" type="text"
                   label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_INDEX_FROM_LABEL"
                   required="true"
                   hide_default="true"
                   hide_none="true"
            />

            <field name="sender_name" type="text"
                   label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_SENDER_NAME_LABEL"/>

            <field name="sender_phone_number" type="text"
                   label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_SENDER_PHONE_NUMBER_LABEL"
