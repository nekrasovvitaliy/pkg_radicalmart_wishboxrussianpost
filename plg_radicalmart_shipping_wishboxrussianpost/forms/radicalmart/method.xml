                   class="btn-group btn-group-yesno"
                   default="required">
                <option value="required">PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_OPTION_REQUIRED</option>
                <option value="not_required">PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_OPTION_NOT_REQUIRED</option>
                <option value="hidden">PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_OPTION_HIDDEN</option>
            </field>

            <field name="field_street_to" type="radio"
                   label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_STREET_TO_LABEL"
                   class="btn-group btn-group-yesno"
                   default="required">
                <option value="required">PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_OPTION_REQUIRED</option>
                <option value="not_required">PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_OPTION_NOT_REQUIRED</option>
                <option value="hidden">PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_OPTION_HIDDEN</option>
            </field>

            <field name="field_house_to" type="radio"
