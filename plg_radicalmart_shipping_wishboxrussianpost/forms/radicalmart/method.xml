                   label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_SELLER_NAME_LABEL"/>

            <field name="seller_inn" type="text"
                   label="PLG_RADICALMART_SHIPPING_WISHBOXRUSSIANPOST_FIELD_SELLER_INN_LABEL"/>

            <field name="seller_phone" type="text"
